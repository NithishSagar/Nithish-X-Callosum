# Which company config to build. See lib/companies/ for the available keys.
# Unset or unrecognised falls back to 'callosum'.
#
#   callosum   -> Callosum Applied AI  (main branch)
#   ineffable  -> Ineffable Intelligence
#
# This is read at BUILD time, not request time — changing it requires a rebuild.
NEXT_PUBLIC_COMPANY=callosum

# Optional: pins metadataBase for social-card URLs. Vercel supplies VERCEL_URL
# per deployment, so this is only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://nithish-x-callosum.vercel.app
